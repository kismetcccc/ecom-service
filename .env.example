# OpenAI-compatible API; this example uses Alibaba Cloud Model Studio (Beijing).
OPENAI_API_KEY=sk-your-dashscope-api-key
OPENAI_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1

# Chat model
MODEL_NAME=qwen-plus
# 所有聊天阶段共享的进程级限流；多 worker/多副本需要分布式额度协调。
LLM_MAX_INFLIGHT=1
LLM_REQUESTS_PER_MINUTE=20
LLM_TIMEOUT_SECONDS=20
# 百炼 qwen3.8-2.4t-a95b 强制思考模型：限制在线各阶段的思考 token。
LLM_REQUIRED_THINKING_BUDGET=128
LLM_RATE_LIMIT_COOLDOWN_SECONDS=60
TEMPERATURE=0.7
# Ignore system HTTP_PROXY/HTTPS_PROXY by default. Set true only for a valid proxy.
OPENAI_TRUST_ENV=false

# SQLite 商品库，无需安装独立数据库服务。
DATABASE_URL=sqlite:///app/sessions/ecom.db

# MCP
MCP_ENABLED=false
MCP_SERVER_URL=http://127.0.0.1:9123/mcp
MCP_CONNECT_TIMEOUT=5
MCP_CALL_TIMEOUT=8
MCP_MAX_INFLIGHT=32
MCP_READ_RETRIES=1
MCP_FAILURE_THRESHOLD=3
MCP_RECOVERY_SECONDS=15
# Enable only when local read sources match MCP sources and freshness is verified.
MCP_ALLOW_LOCAL_READ_FALLBACK=false
ORDER_DATABASE_PATH=app/sessions/orders.db
# Local demo only. Disable when connecting a real order service.
SEED_DEMO_ORDERS=true

# Multi-Agent
MULTI_AGENT_ENABLED=false
# 启用 Multi-Agent 后，退换货自动走订单/政策/资格核验；仍需页面确认退款。
MULTI_AGENT_WORKFLOWS_ENABLED=true
# 独立质检（最多增加 3 次模型调用）：enforce 阻断 / shadow 仅观测 / off 关闭
MULTI_AGENT_REVIEW_MODE=enforce
MULTI_AGENT_REVIEW_MODEL=
MULTI_AGENT_REVIEW_FAST_MODE=true
MULTI_AGENT_REVIEW_MAX_REPAIRS=1
MULTI_AGENT_REVIEW_TIMEOUT_SECONDS=25
MULTI_AGENT_REVIEW_BUDGET_SECONDS=60
MULTI_AGENT_RULES_ENABLED=true
MULTI_AGENT_ROUTE_MIN_CONFIDENCE=0.75
MULTI_AGENT_MAX_TASKS=2
# Only independent read-only tasks handled by distinct agents may run concurrently.
MULTI_AGENT_PARALLEL_READS=true
MULTI_AGENT_PARALLEL_REQUESTS=8
MULTI_AGENT_MODEL_TIMEOUT_SECONDS=30
MULTI_AGENT_MINIMAL_CONTEXT=true
MULTI_AGENT_CONTEXT_RECENT_MESSAGES=8

# Memory
MEMORY_ENABLED=true
MEMORY_DIR=app/sessions/memory
MEMORY_USER_ID=default
MAX_LTM_FACTS=50
MAX_LTM_INTERACTION_SUMMARIES=100
LTM_INTERACTION_RETENTION_DAYS=180
MEMORY_REQUIRE_CONSENT=true
MEMORY_CONSENT_DB_PATH=app/sessions/memory_control.db
# Optional Fernet key. Multi-instance production deployments must share one key.
MEMORY_ENCRYPTION_KEY=
# MR-08: memory lifecycle (hours for STM, days for LTM).
STM_IDENTITY_TTL_HOURS=2160
STM_PREFERENCE_TTL_HOURS=720
STM_INTENT_TTL_HOURS=24
STM_EMOTION_TTL_HOURS=6
STM_ORDER_TTL_HOURS=72
STM_OTHER_TTL_HOURS=24
LTM_IDENTITY_TTL_DAYS=180
LTM_PREFERENCE_TTL_DAYS=365
LTM_BEHAVIOR_TTL_DAYS=180
LTM_ISSUE_TTL_DAYS=30
LTM_OTHER_TTL_DAYS=90
LTM_CONFIRMATION_DAYS=180
MEMORY_RETRIEVAL_TOP_K=5
# Optional lower-cost model used only for memory extraction.
MEMORY_EXTRACTION_MODEL=

# Skills
SKILLS_ENABLED=true
SKILLS_DIR=app/agent/skills/definitions

# Evaluation
EVAL_DATASET_PATH=app/evaluation/cases.json
EVAL_USE_JUDGE=true
EVAL_PASS_THRESHOLD=0.6

# RAG / Embeddings. Blank values reuse the chat API key and base URL.
EMBEDDING_API_KEY=
EMBEDDING_BASE_URL=
EMBEDDING_MODEL=text-embedding-v4
# Alibaba text-embedding-v4 accepts at most 10 texts per request.
EMBEDDING_BATCH_SIZE=10
KB_DIR=app/agent/rag/knowledge
RAG_BACKEND=numpy
# 知识来源默认保持 RAG；管理命令的 control.json 优先于此初始值。
KNOWLEDGE_MODE=rag
WIKI_STORE_DIR=app/sessions/llm_wiki
# Qdrant/Chroma 不可达时读取兼容的本地索引；生产环境可留空关闭降级。
RAG_FALLBACK_BACKEND=numpy
KB_INDEX_PATH=app/sessions/kb_index.json
CHROMA_PERSIST_DIR=app/sessions/chroma
CHROMA_COLLECTION=ecom_kb
# Qdrant 推荐用于多进程/服务部署。先启动 qdrant，再构建索引后切换 RAG_BACKEND=qdrant。
QDRANT_URL=http://127.0.0.1:6333
QDRANT_COLLECTION=ecom_kb
QDRANT_API_KEY=
QDRANT_TIMEOUT_SECONDS=5
# 正式政策环境必须关闭演示文档；相似度阈值需经离线标注集校准后再启用。
RAG_ALLOW_DEMO_POLICIES=true
RAG_MIN_SCORE=0
# Final retrieval: BM25 + dense -> RRF -> cross-encoder. dense is the rollback baseline.
RAG_RETRIEVAL_MODE=hybrid
RAG_CANDIDATE_K=40
RAG_RRF_K=60
RAG_MIN_RRF_SCORE=0
RAG_RERANK_ENABLED=true
RAG_RERANK_MODEL=BAAI/bge-reranker-base
RAG_RERANK_DEVICE=cpu
RAG_RERANK_TOP_N=20
RAG_RERANK_BATCH_SIZE=8
RAG_RERANK_MAX_LENGTH=512
RAG_RERANK_LOCAL_FILES_ONLY=false
# rrf: explicit degraded result; error: fail request when reranking is unavailable.
RAG_RERANK_FAILURE_MODE=rrf
RAG_MIN_RERANK_SCORE=0

# Conversation context budget. The effective model input budget is
# CONTEXT_WINDOW_TOKENS - CONTEXT_RESERVED_OUTPUT_TOKENS.
CONTEXT_WINDOW_TOKENS=28000
CONTEXT_RESERVED_OUTPUT_TOKENS=4000
CONTEXT_KEEP_RECENT_MESSAGES=6
SUMMARY_VERSION_LIMIT=10

# High-concurrency HTTP service
SERVER_HOST=0.0.0.0
SERVER_PORT=8000
# Maximum number of model requests executed by one process at the same time.
SERVER_MAX_CONCURRENCY=32
# Seconds a request may wait for a free execution slot before returning 503.
SERVER_QUEUE_TIMEOUT=10
SERVER_MAX_SESSIONS=1000
SERVER_SESSION_IDLE_SECONDS=1800
CONCURRENT_SESSION_DIR=app/sessions/concurrent

# Authentication. Production multi-instance deployments must share a strong secret.
AUTH_DATABASE_PATH=app/sessions/auth.db
AUTH_SECRET_KEY=replace-with-at-least-32-random-characters
AUTH_TOKEN_TTL_SECONDS=43200
AUTH_MAX_CONCURRENCY=4
AUTH_ATTEMPTS_PER_MINUTE=20
# CR-04：仅本地排障时启用模型正文日志；生产会话密钥请注入有效 Fernet 密钥。
LOG_MODEL_CONTENT=false
SESSION_ENCRYPTION_KEY=
