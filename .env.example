# OpenAI-compatible API; this example uses Alibaba Cloud Model Studio (Beijing).
OPENAI_API_KEY=sk-your-dashscope-api-key
OPENAI_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1

# Chat model
MODEL_NAME=qwen-plus
TEMPERATURE=0.7
# Ignore system HTTP_PROXY/HTTPS_PROXY by default. Set true only for a valid proxy.
OPENAI_TRUST_ENV=false

# MCP
MCP_ENABLED=false
MCP_SERVER_URL=http://127.0.0.1:9123/mcp

# Multi-Agent
MULTI_AGENT_ENABLED=false

# Memory
MEMORY_ENABLED=true
MEMORY_DIR=app/sessions/memory
MEMORY_USER_ID=default
MAX_LTM_FACTS=50

# Skills
SKILLS_ENABLED=true
SKILLS_DIR=app/agent/skills/definitions

# Evaluation
EVAL_DATASET_PATH=app/evaluation/cases.json
EVAL_USE_JUDGE=true
EVAL_PASS_THRESHOLD=0.6

# RAG / Embeddings. Blank values reuse the chat API key and base URL.
EMBEDDING_API_KEY=
EMBEDDING_BASE_URL=
EMBEDDING_MODEL=text-embedding-v4
# Alibaba text-embedding-v4 accepts at most 10 texts per request.
EMBEDDING_BATCH_SIZE=10
KB_DIR=app/agent/rag/knowledge
RAG_BACKEND=numpy
KB_INDEX_PATH=app/sessions/kb_index.json
CHROMA_PERSIST_DIR=app/sessions/chroma
CHROMA_COLLECTION=ecom_kb

# Conversation context budget. The effective model input budget is
# CONTEXT_WINDOW_TOKENS - CONTEXT_RESERVED_OUTPUT_TOKENS.
CONTEXT_WINDOW_TOKENS=28000
CONTEXT_RESERVED_OUTPUT_TOKENS=4000
CONTEXT_KEEP_RECENT_MESSAGES=6

# High-concurrency HTTP service
SERVER_HOST=0.0.0.0
SERVER_PORT=8000
# Maximum number of model requests executed by one process at the same time.
SERVER_MAX_CONCURRENCY=32
# Seconds a request may wait for a free execution slot before returning 503.
SERVER_QUEUE_TIMEOUT=10
SERVER_MAX_SESSIONS=1000
CONCURRENT_SESSION_DIR=app/sessions/concurrent
